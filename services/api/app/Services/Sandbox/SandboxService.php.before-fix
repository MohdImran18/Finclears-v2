<?php

namespace App\Services\Sandbox;

use Illuminate\Support\Facades\Cache;
use Illuminate\Support\Facades\Http;
use RuntimeException;

class SandboxService
{
    /**
     * Get Sandbox API access token.
     */
    public function getAccessToken(): string
    {
        return Cache::remember(
            'sandbox.access_token',
            now()->addHours(23),
            function () {
                return $this->authenticate();
            }
        );
    }

    /**
     * Authenticate with Sandbox.
     */
    protected function authenticate(): string
    {
        $baseUrl = rtrim(
            config('services.sandbox.base_url'),
            '/'
        );

        $apiKey = config('services.sandbox.api_key');
        $apiSecret = config('services.sandbox.api_secret');
        $apiVersion = config(
            'services.sandbox.api_version',
            '1.0'
        );

        if (!$apiKey || !$apiSecret) {
            throw new RuntimeException(
                'Sandbox API credentials are not configured.'
            );
        }

        $response = Http::timeout(30)
            ->acceptJson()
            ->withHeaders([
                'x-api-key' => $apiKey,
                'x-api-secret' => $apiSecret,
                'x-api-version' => $apiVersion,
            ])
            ->post($baseUrl . '/authenticate');

    
    if ($response->failed()) {
            throw new RuntimeException(
                'Sandbox authentication failed: '
                . $response->body()
            );
        }

        $token = $response->json('data.access_token');

        if (!$token) {
            throw new RuntimeException(
                'Sandbox authentication succeeded but no access token was returned.'
            );
        }

        return $token;
    }

    /**
     * Verify PAN details.
     */
    public function verifyPan(
        string $pan,
        string $name,
        string $dateOfBirth,
        string $reason = 'For ITR filing and customer verification'
    ): array {

        $baseUrl = rtrim(
            config('services.sandbox.base_url'),
            '/'
        );

        $apiKey = config('services.sandbox.api_key');
        $apiVersion = config(
            'services.sandbox.api_version',
            '1.0'
        );

        $token = $this->getAccessToken();

        $response = Http::timeout(30)
            ->acceptJson()
            ->withHeaders([
                'Authorization' => $token,
                'Content-Type' => 'application/json',
                'x-api-key' => $apiKey,
                'x-api-version' => $apiVersion,
            ])
            ->post(
                $baseUrl . '/kyc/pan/verify',
                [
                    '@entity' => 'in.co.sandbox.kyc.pan_verification.request',
                    'pan' => strtoupper(trim($pan)),
                    'name_as_per_pan' => trim($name),
                    'date_of_birth' => $dateOfBirth,
                    'consent' => 'Y',
                    'reason' => ,
                ]
            );

        /*
         * If token expired or authentication is rejected,
         * clear cached token and retry once.
         */
        if ($response->status() === 401) {

            $this->clearToken();

            $token = $this->getAccessToken();

            $response = Http::timeout(30)
                ->acceptJson()
                ->withHeaders([
                    'Authorization' => $token,
                    'Content-Type' => 'application/json',
                    'x-api-key' => $apiKey,
                    'x-api-version' => $apiVersion,
                ])
                ->post(
                    $baseUrl . '/kyc/pan/verify',
                    [
                        '@entity' => 'in.co.sandbox.kyc.pan_verification.request',
                        'pan' => strtoupper(trim($pan)),
                        'name_as_per_pan' => trim($name),
                        'date_of_birth' => $dateOfBirth,
                        'consent' => 'Y',
                        'reason' => $reason,
                    ]
                );
        }

        \Log::info('Sandbox PAN debug', [
        'status' => $response->status(),
        'body' => $response->body(),
        'request_pan' => strtoupper(trim($pan)),
        'request_name' => trim($name),
        'request_dob' => $dateOfBirth,
    ]);

    if ($response->failed()) {
            throw new RuntimeException(
                'Sandbox PAN verification failed: '
                . $response->body()
            );
        }

        $rawBody = $response->body();

    try {
        return json_decode($rawBody, true, 512, JSON_THROW_ON_ERROR);
    } catch (\JsonException $e) {
        return [
            'success' => false,
            'code' => null,
            'message' => 'Sandbox returned invalid JSON.',
            'raw_response' => $rawBody,
            'transaction_id' => null,
        ];
    }
    }

    /**
     * Clear cached access token.
     */
    public function clearToken(): void
    {
        Cache::forget('sandbox.access_token');
    }
}