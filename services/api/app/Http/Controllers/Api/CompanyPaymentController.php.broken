<?php

namespace App\Http\Controllers\Api;

use App\Http\Controllers\Controller;
use App\Models\Company;
use App\Models\CompanyPayment;
use App\Models\Order;
use App\Services\Company\CompanyCashfreeService;
use App\Services\Company\CompanyPaymentService;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Throwable;

class CompanyPaymentController extends Controller
{
    public function __construct(
        protected CompanyPaymentService $payments,
        protected CompanyCashfreeService $cashfree,
    ) {
    }

    /**
     * Create a company payment and Cashfree order.
     */
    public function store(Request $request): JsonResponse
    {
        $validated = $request->validate([
            'company_id' => [
                'required',
                'integer',
                'exists:companies,id',
            ],
            'order_id' => [
                'nullable',
                'integer',
                'exists:orders,id',
            ],
            'amount' => [
                'required',
                'numeric',
                'min:1',
            ],
        ]);

        try {
            $company = Company::findOrFail(
                $validated['company_id']
            );

            $order = null;

            if (!empty($validated['order_id'])) {
                $order = Order::findOrFail(
                    $validated['order_id']
                );

                if ((int) $order->company_id !== (int) $company->id) {
                    return response()->json([
                        'success' => false,
                        'message' => 'Order does not belong to the selected company.',
                    ], 422);
                }
            }

            $payment = $this->payments->createPayment(
                $company,
                (float) $validated['amount'],
                $order
            );

            $cashfreeOrder = $this->cashfree->createOrder(
                $payment
            );

            $payment->refresh();

            return response()->json([
                'success' => true,
                'message' => 'Payment order created successfully.',
                'data' => [
                    'payment' => $payment,
                    'cashfree' => [
                        'order_id' =>
                            $cashfreeOrder['order_id']
                            ?? $payment->gateway_order_id,

                        'payment_session_id' =>
                            $cashfreeOrder['payment_session_id']
                            ?? $payment->payment_session_id,
                    ],
                ],
            ], 201);

        } catch (Throwable $e) {

            report($e);

            return response()->json([
                'success' => false,
                'message' => 'Unable to create payment order.',
                'error' => $e->getMessage(),
            ], 500);
        }
    }

    /**
     * Get local company payment.
     */
    public function show(int $payment): JsonResponse
    {
        $paymentModel = $this->payments->find($payment);

        if (!$paymentModel) {
            return response()->json([
                'success' => false,
                'message' => 'Payment not found.',
            ], 404);
        }

        return response()->json([
            'success' => true,
            'data' => [
                'payment' => $paymentModel,
            ],
        ]);
    }

    /**
     * Verify payment with Cashfree.
     */
    public function verify(int $payment): JsonResponse
    {
        $paymentModel = CompanyPayment::find($payment);

        if (!$paymentModel) {
            return response()->json([
                'success' => false,
                'message' => 'Payment not found.',
            ], 404);
        }

        if (!$paymentModel->gateway_order_id) {
            return response()->json([
                'success' => false,
                'message' => 'Cashfree order ID is missing.',
            ], 422);
        }

        try {
            $result = $this->cashfree->verifyPayment(
                $paymentModel,
                $paymentModel->gateway_order_id
            );

            $paymentModel->refresh();

            return response()->json([
                'success' => true,
                'message' => 'Payment verification completed.',
                'data' => [
                    'payment' => $paymentModel,
                    'verification' => $result,
                ],
            ]);

        } catch (Throwable $e) {

            report($e);

            return response()->json([
                'success' => false,
                'message' => 'Unable to verify payment.',
                'error' => $e->getMessage(),
            ], 500);
        }
    }

    /**
     * Cashfree webhook.
     *
     * Receives asynchronous payment status updates from Cashfree.
     */
    public function cashfreeWebhook(Request $request): JsonResponse
    {
        $payload = $request->all();

        $orderId =
            data_get($payload, 'data.order.order_id') ??
            data_get($payload, 'order.order_id') ??
            data_get($payload, 'order_id');

        if (!$orderId) {
            return response()->json([
                'success' => false,
                'message' => 'Cashfree order ID is missing.',
            ], 422);
        }

        $payment = CompanyPayment::where(
            'gateway_order_id',
            $orderId
        )->first();

        if (!$payment) {
            return response()->json([
                'success' => false,
                'message' => 'Payment record not found.',
            ], 404);
        }

        $paymentStatus = strtoupper((string) (
            data_get($payload, 'data.payment.payment_status') ??
            data_get($payload, 'payment.payment_status') ??
            data_get($payload, 'payment_status') ??
            ''
        ));

        $errorDetails =
            data_get($payload, 'data.payment.error_details') ??
            data_get($payload, 'payment.error_details') ??
            data_get($payload, 'error_details');

        $paymentMessage =
            data_get($payload, 'data.payment.payment_message') ??
            data_get($payload, 'payment.payment_message') ??
            data_get($payload, 'payment_message');

        $failureReason =
            $paymentMessage ??
            data_get($errorDetails, 'error_description') ??
            data_get($errorDetails, 'error_message') ??
            data_get($errorDetails, 'message') ??
            data_get($errorDetails, 'error_code') ??
            null;

        $gatewayResponse = is_array($payment->gateway_response)
            ? $payment->gateway_response
            : [];

        $payment->gateway_response = array_merge(
            $gatewayResponse,
            [
                'webhook' => $payload,
                'webhook_payment_status' => $paymentStatus,
                'failure_reason' => $failureReason,
                'error_details' => $errorDetails,
                'payment_message' => $paymentMessage,
                'webhook_received_at' => now()->toISOString(),
            ]
        );

        if ($paymentStatus === 'SUCCESS') {
            $payment->payment_status = 'success';
            $payment->paid_at = $payment->paid_at ?? now();

            $payment->company()->update(['payment_status' => 'success']);

        } elseif (in_array(
            $paymentStatus,
            ['FAILED', 'USER_DROPPED', 'CANCELLED', 'EXPIRED'],
            true
        )) {
            $payment->payment_status = 'failed';
            $payment->company()->update(['payment_status' => 'failed']);
        }

        $payment->save();

        return response()->json([
            'success' => true,
            'message' => 'Cashfree webhook processed successfully.',
            'data' => [
                'payment_id' => $payment->id,
                'order_id' => $orderId,
                'payment_status' => $payment->payment_status,
                'failure_reason' => $failureReason,
            ]
        ]);
    }

    /**
     * Cashfree return URL.
     *
     * Cashfree redirects the customer here after checkout.
     */
    public function cashfreeReturn(
        Request $request
    ): \Symfony\Component\HttpFoundation\Response {

        $orderId = $request->query('order_id');

        if (!$orderId) {
            return redirect(
                rtrim(config('app.frontend_url', env('FRONTEND_URL', 'http://localhost:3000')), '/') .
                '/dashboard/orders'
            );
        }

        $payment = CompanyPayment::where(
            'gateway_order_id',
            $orderId
        )->first();

        if (!$payment) {
            return redirect(
                rtrim(config('app.frontend_url', env('FRONTEND_URL', 'http://localhost:3000')), '/') .
                '/dashboard/orders'
            );
        }

        try {

            $this->cashfree->verifyPayment(
                $payment,
                $orderId
            );

            $payment->refresh();

            $frontendUrl = rtrim(
                config('app.frontend_url', env('FRONTEND_URL', 'http://localhost:3000')),
                '/'
            );

            return redirect(
                $frontendUrl .
                '/dashboard/orders/' .
                $payment->order_id .
                '?payment_id=' .
                $payment->id .
                '&payment_status=' .
                urlencode($payment->payment_status)
            );

        } catch (Throwable $e) {

            report($e);

            $frontendUrl = rtrim(
                config('app.frontend_url', env('FRONTEND_URL', 'http://localhost:3000')),
                '/'
            );

            return redirect(
                $frontendUrl .
                '/dashboard/orders/' .
                $payment->order_id .
                '?payment_id=' .
                $payment->id .
                '&payment_status=verification_failed'
            );
        }
    }
}

