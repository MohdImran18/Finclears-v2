import axios from "axios";
import type {
  Blog,
  BlogListResponse,
  BlogPayload,
} from "@/types/blog/blog";

const API_URL =
  process.env.NEXT_PUBLIC_API_URL ||
  "http://127.0.0.1:8000/api/v1";

const client = axios.create({
  baseURL: API_URL,
  headers: {
    Accept: "application/json",
    "Content-Type": "application/json",
  },
});

client.interceptors.request.use((config) => {
  if (typeof window !== "undefined") {
    const token =
      localStorage.getItem("token") ||
      localStorage.getItem("access_token") ||
      localStorage.getItem("auth_token");

    if (token) {
      config.headers.Authorization = `Bearer ${token}`;
    }
  }

  return config;
});

export async function getBlogs(params?: {
  page?: number;
  per_page?: number;
  search?: string;
  status?: boolean;
  featured?: boolean;
}) {
  const response = await client.get<BlogListResponse>("/admin/blogs", {
    params,
  });

  return response.data;
}

export async function getBlog(id: number) {
  const response = await client.get<{ data: { blog: Blog } }>(
    `/admin/blogs/${id}`
  );

  return response.data;
}

export async function createBlog(payload: BlogPayload) {
  const response = await client.post<{ data: { blog: Blog } }>(
    "/admin/blogs",
    payload
  );

  return response.data;
}

export async function updateBlog(
  id: number,
  payload: BlogPayload
) {
  const response = await client.put<{ data: { blog: Blog } }>(
    `/admin/blogs/${id}`,
    payload
  );

  return response.data;
}

export async function patchBlog(
  id: number,
  payload: Partial<BlogPayload>
) {
  const response = await client.patch<{ data: { blog: Blog } }>(
    `/admin/blogs/${id}`,
    payload
  );

  return response.data;
}

export async function publishBlog(id: number) {
  const response = await client.post<{ data: { blog: Blog } }>(
    `/admin/blogs/${id}/publish`
  );

  return response.data;
}

export async function unpublishBlog(id: number) {
  const response = await client.post<{ data: { blog: Blog } }>(
    `/admin/blogs/${id}/unpublish`
  );

  return response.data;
}

export async function featureBlog(id: number) {
  const response = await client.post<{ data: { blog: Blog } }>(
    `/admin/blogs/${id}/feature`
  );

  return response.data;
}

export async function unfeatureBlog(id: number) {
  const response = await client.post<{ data: { blog: Blog } }>(
    `/admin/blogs/${id}/unfeature`
  );

  return response.data;
}

export async function deleteBlog(id: number) {
  const response = await client.delete(`/admin/blogs/${id}`);

  return response.data;
}