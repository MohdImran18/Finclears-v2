"use client";

import { useEffect, useState } from "react";
import type { Employee } from "@/types/employee/employee";
import { getEmployees } from "@/lib/api/employees/employeeApi";
import {
  checkIn,
  checkOut,
  getAttendances,
  markAttendanceStatus,
} from "@/lib/api/attendance/attendanceApi";
import type {
  Attendance,
  AttendanceStatus,
} from "@/types/attendance/attendance";

const STATUS_OPTIONS: Array<{
  value: AttendanceStatus | "";
  label: string;
}> = [
  { value: "", label: "All Statuses" },
  { value: "present", label: "Present" },
  { value: "absent", label: "Absent" },
  { value: "half_day", label: "Half Day" },
  { value: "leave", label: "Leave" },
  { value: "holiday", label: "Holiday" },
  { value: "week_off", label: "Week Off" },
];

const MANUAL_STATUS_OPTIONS: Array<{
  value: Exclude<AttendanceStatus, "present">;
  label: string;
}> = [
  { value: "absent", label: "Absent" },
  { value: "half_day", label: "Half Day" },
  { value: "leave", label: "Leave" },
  { value: "holiday", label: "Holiday" },
  { value: "week_off", label: "Week Off" },
];

function formatDate(value: string) {
  return new Date(value).toLocaleDateString("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
}

function formatTime(value: string | null) {
  if (!value) return "-";

  return new Date(value).toLocaleTimeString("en-IN", {
    hour: "2-digit",
    minute: "2-digit",
  });
}

function minutesToHours(minutes: number) {
  const hours = Math.floor(minutes / 60);
  const remainingMinutes = minutes % 60;

  return `${hours}h ${remainingMinutes}m`;
}

function statusLabel(status: AttendanceStatus) {
  switch (status) {
    case "half_day":
      return "Half Day";
    case "week_off":
      return "Week Off";
    default:
      return status.charAt(0).toUpperCase() + status.slice(1);
  }
}

export default function AttendancePage() {
  const [attendance, setAttendance] = useState<Attendance[]>([]);
  const [employees, setEmployees] = useState<Employee[]>([]);
  const [employeesLoading, setEmployeesLoading] = useState(true);
  const [loading, setLoading] = useState(true);
  const [actionLoading, setActionLoading] = useState(false);
  const [error, setError] = useState("");
  const [success, setSuccess] = useState("");

  const [status, setStatus] = useState<AttendanceStatus | "">("");

  const [employeeProfileId, setEmployeeProfileId] =
    useState("");
  const [actionDate, setActionDate] = useState("");
  const [manualStatus, setManualStatus] =
    useState<Exclude<AttendanceStatus, "present">>("half_day");
  const [notes, setNotes] = useState("");


  async function loadEmployees() {
    try {
      setEmployeesLoading(true);

      const response = await getEmployees({
        page: 1,
        per_page: 100,
        status: "active",
      });

      setEmployees(response.data.data);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Failed to load employees."
      );
    } finally {
      setEmployeesLoading(false);
    }
  }
  async function loadAttendance() {
    try {
      setLoading(true);
      setError("");

      const response = await getAttendances({
        status: status || undefined,
      });

      setAttendance(response.data);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Failed to load attendance records."
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadEmployees();
    loadAttendance();
  }, [status]);

  function clearMessages() {
    setError("");
    setSuccess("");
  }

  function validateActionFields() {
    if (!employeeProfileId.trim()) {
      setError("Employee Profile ID is required.");
      return false;
    }

    if (!actionDate) {
      setError("Attendance date is required.");
      return false;
    }

    return true;
  }

  async function handleCheckIn() {
    clearMessages();

    if (!validateActionFields()) return;

    try {
      setActionLoading(true);

      await checkIn({
        employee_profile_id: Number(employeeProfileId),
        check_in_at: `${actionDate} 10:00:00`,
        check_in_source: "manual",
        notes: notes || undefined,
      });

      setSuccess("Employee checked in successfully.");
      setNotes("");

      await loadAttendance();
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Failed to check employee in."
      );
    } finally {
      setActionLoading(false);
    }
  }

  async function handleCheckOut() {
    clearMessages();

    if (!validateActionFields()) return;

    try {
      setActionLoading(true);

      await checkOut({
        employee_profile_id: Number(employeeProfileId),
        check_out_at: `${actionDate} 19:00:00`,
        check_out_source: "manual",
        notes: notes || undefined,
      });

      setSuccess("Employee checked out successfully.");
      setNotes("");

      await loadAttendance();
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Failed to check employee out."
      );
    } finally {
      setActionLoading(false);
    }
  }

  async function handleMarkStatus() {
    clearMessages();

    if (!validateActionFields()) return;

    try {
      setActionLoading(true);

      await markAttendanceStatus({
        employee_profile_id: Number(employeeProfileId),
        attendance_date: actionDate,
        status: manualStatus,
        notes: notes || undefined,
      });

      setSuccess(
        `Attendance marked as ${statusLabel(manualStatus)}.`
      );

      setNotes("");

      await loadAttendance();
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Failed to update attendance status."
      );
    } finally {
      setActionLoading(false);
    }
  }

  return (
    <div className="space-y-6 p-6">
      <div className="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
          <h1 className="text-2xl font-semibold">
            Attendance
          </h1>

          <p className="text-sm text-muted-foreground">
            Manage employee attendance, status and working hours.
          </p>
        </div>

        <button
          type="button"
          onClick={loadAttendance}
          disabled={loading || actionLoading}
          className="rounded-md border px-4 py-2 text-sm font-medium hover:bg-muted disabled:cursor-not-allowed disabled:opacity-50"
        >
          Refresh
        </button>
      </div>

      <div className="rounded-lg border bg-background p-5">
        <div className="mb-4">
          <h2 className="text-lg font-semibold">
            Attendance Actions
          </h2>

          <p className="text-sm text-muted-foreground">
            Use these actions to manage an employee&apos;s attendance.
          </p>
        </div>

        <div className="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          <div className="space-y-2">
            <label
              htmlFor="employee-profile-id"
              className="text-sm font-medium"
            >
              Employee
            </label>

            <select
              id="employee-profile-id"
              value={employeeProfileId}
              onChange={(event) =>
                setEmployeeProfileId(event.target.value)
              }
              disabled={employeesLoading || actionLoading}
              className="w-full rounded-md border bg-background px-3 py-2 text-sm disabled:cursor-not-allowed disabled:opacity-50"
            >
              <option value="">
                {employeesLoading
                  ? "Loading employees..."
                  : "Select employee"}
              </option>

              {employees.map((employee) => (
                <option
                  key={employee.id}
                  value={employee.id}
                >
                  {employee.employee_code} -{" "}
                  {employee.user?.name || "Unnamed Employee"}
                </option>
              ))}
            </select>
          </div>

          <div className="space-y-2">
            <label
              htmlFor="action-date"
              className="text-sm font-medium"
            >
              Attendance Date
            </label>

            <input
              id="action-date"
              type="date"
              value={actionDate}
              onChange={(event) =>
                setActionDate(event.target.value)
              }
              className="w-full rounded-md border bg-background px-3 py-2 text-sm"
            />
          </div>

          <div className="space-y-2">
            <label
              htmlFor="manual-status"
              className="text-sm font-medium"
            >
              Manual Status
            </label>

            <select
              id="manual-status"
              value={manualStatus}
              onChange={(event) =>
                setManualStatus(
                  event.target.value as Exclude<
                    AttendanceStatus,
                    "present"
                  >
                )
              }
              className="w-full rounded-md border bg-background px-3 py-2 text-sm"
            >
              {MANUAL_STATUS_OPTIONS.map((option) => (
                <option
                  key={option.value}
                  value={option.value}
                >
                  {option.label}
                </option>
              ))}
            </select>
          </div>

          <div className="space-y-2">
            <label
              htmlFor="attendance-notes"
              className="text-sm font-medium"
            >
              Notes
            </label>

            <input
              id="attendance-notes"
              type="text"
              value={notes}
              onChange={(event) =>
                setNotes(event.target.value)
              }
              placeholder="Optional notes"
              className="w-full rounded-md border bg-background px-3 py-2 text-sm"
            />
          </div>
        </div>

        <div className="mt-5 flex flex-wrap gap-3">
          <button
            type="button"
            onClick={handleCheckIn}
            disabled={actionLoading}
            className="rounded-md border px-4 py-2 text-sm font-medium hover:bg-muted disabled:cursor-not-allowed disabled:opacity-50"
          >
            Check In
          </button>

          <button
            type="button"
            onClick={handleCheckOut}
            disabled={actionLoading}
            className="rounded-md border px-4 py-2 text-sm font-medium hover:bg-muted disabled:cursor-not-allowed disabled:opacity-50"
          >
            Check Out
          </button>

          <button
            type="button"
            onClick={handleMarkStatus}
            disabled={actionLoading}
            className="rounded-md border px-4 py-2 text-sm font-medium hover:bg-muted disabled:cursor-not-allowed disabled:opacity-50"
          >
            Mark Status
          </button>
        </div>
      </div>

      {success && (
        <div className="rounded-md border border-green-300 bg-green-50 p-4 text-sm text-green-700">
          {success}
        </div>
      )}

      {error && (
        <div className="rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-700">
          {error}
        </div>
      )}

      <div className="rounded-lg border bg-background p-4">
        <div className="flex flex-col gap-2 sm:flex-row sm:items-center">
          <label
            htmlFor="attendance-status"
            className="text-sm font-medium"
          >
            Filter Status
          </label>

          <select
            id="attendance-status"
            value={status}
            onChange={(event) =>
              setStatus(
                event.target.value as AttendanceStatus | ""
              )
            }
            className="rounded-md border bg-background px-3 py-2 text-sm"
          >
            {STATUS_OPTIONS.map((option) => (
              <option
                key={option.value}
                value={option.value}
              >
                {option.label}
              </option>
            ))}
          </select>
        </div>
      </div>

      <div className="overflow-hidden rounded-lg border">
        <div className="overflow-x-auto">
          <table className="w-full min-w-[1000px] text-sm">
            <thead className="border-b bg-muted/50">
              <tr>
                <th className="px-4 py-3 text-left font-medium">
                  Employee
                </th>
                <th className="px-4 py-3 text-left font-medium">
                  Date
                </th>
                <th className="px-4 py-3 text-left font-medium">
                  Shift
                </th>
                <th className="px-4 py-3 text-left font-medium">
                  Check In
                </th>
                <th className="px-4 py-3 text-left font-medium">
                  Check Out
                </th>
                <th className="px-4 py-3 text-left font-medium">
                  Working
                </th>
                <th className="px-4 py-3 text-left font-medium">
                  Late
                </th>
                <th className="px-4 py-3 text-left font-medium">
                  Overtime
                </th>
                <th className="px-4 py-3 text-left font-medium">
                  Status
                </th>
              </tr>
            </thead>

            <tbody>
              {loading ? (
                <tr>
                  <td
                    colSpan={9}
                    className="px-4 py-8 text-center text-muted-foreground"
                  >
                    Loading attendance...
                  </td>
                </tr>
              ) : attendance.length === 0 ? (
                <tr>
                  <td
                    colSpan={9}
                    className="px-4 py-8 text-center text-muted-foreground"
                  >
                    No attendance records found.
                  </td>
                </tr>
              ) : (
                attendance.map((record) => (
                  <tr
                    key={record.id}
                    className="border-b last:border-b-0"
                  >
                    <td className="px-4 py-3">
                      <div className="font-medium">
                        {record.employee_profile?.user?.name ||
                          "Unknown Employee"}
                      </div>

                      <div className="text-xs text-muted-foreground">
                        {record.employee_profile?.employee_code ||
                          "-"}
                      </div>
                    </td>

                    <td className="px-4 py-3">
                      {formatDate(record.attendance_date)}
                    </td>

                    <td className="px-4 py-3">
                      {record.shift?.name || "-"}
                    </td>

                    <td className="px-4 py-3">
                      {formatTime(record.check_in_at)}
                    </td>

                    <td className="px-4 py-3">
                      {formatTime(record.check_out_at)}
                    </td>

                    <td className="px-4 py-3">
                      {minutesToHours(record.working_minutes)}
                    </td>

                    <td className="px-4 py-3">
                      {record.late_minutes}m
                    </td>

                    <td className="px-4 py-3">
                      {minutesToHours(record.overtime_minutes)}
                    </td>

                    <td className="px-4 py-3">
                      <span className="rounded-full border px-2.5 py-1 text-xs font-medium">
                        {statusLabel(record.status)}
                      </span>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}
