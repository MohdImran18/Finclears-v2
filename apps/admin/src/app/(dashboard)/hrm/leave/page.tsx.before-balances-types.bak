            </strong>
          </div>
        </div>
      </div>

      <div className="leaveTabs">
        <button
          type="button"
          className={
            activeTab === "applications" ? "active" : ""
          }
          onClick={() => setActiveTab("applications")}
        >
          Applications
        </button>

        <button
          type="button"
          className={
            activeTab === "balances" ? "active" : ""
          }
          onClick={() => setActiveTab("balances")}
        >
          Leave Balances
        </button>

        <button
          type="button"
          className={
            activeTab === "types" ? "active" : ""
          }
          onClick={() => setActiveTab("types")}
        >
          Leave Types
        </button>
      </div>


      {showCreateForm && (
        <div className="modalOverlay">
          <div className="modalCard">
            <div className="modalHeader">
              <div>
                <h2>New Leave Application</h2>
                <p>
                  Submit a leave request for an employee.
                </p>
              </div>

              <button
                type="button"
                className="iconButton"
                onClick={closeCreateForm}
                disabled={saving}
                aria-label="Close"
              >
                <X size={18} />
              </button>
            </div>

            <form
              className="leaveForm"
              onSubmit={handleCreateApplication}
            >
              {formError && (
                <div className="errorBanner">
                  <AlertCircle size={18} />
                  <div>
                    <strong>Unable to submit leave</strong>
                    <span>{formError}</span>
                  </div>
                </div>
              )}

              <div className="formGrid">
                <label>
                  <span>Employee *</span>
                  <select
                    value={form.employee_profile_id}
                    onChange={(event) =>
                      setForm((current) => ({
                        ...current,
                        employee_profile_id:
                          event.target.value,
                      }))
                    }
                    required
                  >
                    <option value="">
                      Select employee
                    </option>

                    {balances
                      .filter(
                        (balance, index, array) =>
                          array.findIndex(
                            (item) =>
                              item.employee_profile_id ===
                              balance.employee_profile_id
                          ) === index
                      )
                      .map((balance) => (
                        <option
                          key={balance.employee_profile_id}
                          value={balance.employee_profile_id}
                        >
                          {balance.employee_profile
                            ?.employee_code ||
                            `Employee #${balance.employee_profile_id}`}
                        </option>
                      ))}
                  </select>
                </label>

                <label>
                  <span>Leave Type *</span>
                  <select
                    value={form.leave_type_id}
                    onChange={(event) =>
                      setForm((current) => ({
                        ...current,
                        leave_type_id:
                          event.target.value,
                      }))
                    }
                    required
                  >
                    <option value="">
                      Select leave type
                    </option>

                    {leaveTypes
                      .filter((type) => type.is_active)
                      .map((type) => (
                        <option
                          key={type.id}
                          value={type.id}
                        >
                          {type.name} ({type.code})
                        </option>
                      ))}
                  </select>
                </label>

                <label>
                  <span>From Date *</span>
                  <input
                    type="date"
                    value={form.from_date}
                    onChange={(event) =>
                      setForm((current) => ({
                        ...current,
                        from_date:
                          event.target.value,
                      }))
                    }
                    required
                  />
                </label>

                <label>
                  <span>To Date *</span>
                  <input
                    type="date"
                    min={form.from_date || undefined}
                    value={form.to_date}
                    onChange={(event) =>
                      setForm((current) => ({
                        ...current,
                        to_date:
                          event.target.value,
                      }))
                    }
                    required
                  />
                </label>
              </div>

              {form.employee_profile_id &&
                form.leave_type_id && (
                  <div className="balancePreview">
                    <span>Available Balance</span>
                    <strong>
                      {selectedBalance
                        ? (
                            selectedBalance.available_balance ??
                            Number(
                              selectedBalance.opening_balance
                            ) +
                              Number(
                                selectedBalance.allocated
                              ) +
                              Number(
                                selectedBalance.adjusted
                              ) -
                              Number(
                                selectedBalance.used
                              ) -
                              Number(
                                selectedBalance.pending
                              )
                          ).toFixed(2)
                        : "0.00"}{" "}
                      days
                    </strong>
                  </div>
                )}

              <div className="daysPreview">
                <span>Requested Days</span>
                <strong>
                  {calculatedDays}{" "}
                  {calculatedDays === 1
                    ? "day"
                    : "days"}
                </strong>
              </div>

              <label>
                <span>Reason</span>
                <textarea
                  rows={4}
                  maxLength={5000}
                  placeholder="Enter reason for leave..."
                  value={form.reason}
                  onChange={(event) =>
                    setForm((current) => ({
                      ...current,
                      reason: event.target.value,
                    }))
                  }
                />
              </label>

              <div className="modalActions">
                <button
                  type="button"
                  className="secondaryButton"
                  onClick={closeCreateForm}
                  disabled={saving}
                >
                  Cancel
                </button>

                <button
                  type="submit"
                  className="primaryButton"
                  disabled={saving}
                >
                  {saving ? (
                    <>
                      <RefreshCw
                        size={16}
                        className="spin"
                      />
                      Submitting...
                    </>
                  ) : (
                    <>
                      <CheckCircle2 size={16} />
                      Submit Leave
                    </>
                  )}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
      <div className="contentCard">
        {loading ? (
          <div className="emptyState">
            <RefreshCw size={32} className="spin" />
            <h3>Loading leave data</h3>
            <p>
              Fetching the latest information from the HRM
              system.
            </p>
          </div>
        ) : (
          <>
            {activeTab === "applications" && (
              <>
                <div className="cardHeader">
                  <div>
                    <h2>Leave Applications</h2>
                    <p>
                      Review employee leave requests and their
                      current status.
                    </p>
                  </div>

                  <button
                    type="button"
                    className="primaryButton"
                    onClick={openCreateForm}
                  >
                    <Plus size={16} />
                    New Leave Application
                  </button>
                </div>

                {applications.length === 0 ? (
                  <div className="emptyState">
                    <CalendarDays size={34} />
                    <h3>No leave applications</h3>
                    <p>
                      There are currently no leave applications.
                    </p>
                  </div>
                ) : (
                  <div className="tableWrapper">
                    <table className="leaveTable">
                      <thead>
                        <tr>
                          <th>Employee</th>
                          <th>Leave Type</th>
                          <th>Dates</th>
                          <th>Days</th>
                          <th>Status</th>
                          <th>Reason</th>
                          <th>Actions</th>
                        </tr>
                      </thead>

                      <tbody>
                        {applications.map((application) => (
                          <tr key={application.id}>
                            <td>
                              <strong>
                                {application.employee_profile
                                  ?.employee_code ||
                                  `Employee #${application.employee_profile_id}`}
                              </strong>
                            </td>

                            <td>
                              {application.leave_type?.name ||
                                "-"}
                            </td>

                            <td>
                              <div className="dateRange">
                                <span>
                                  {formatDate(
                                    application.from_date
                                  )}
                                </span>
                                <span>to</span>
                                <span>
                                  {formatDate(
                                    application.to_date
                                  )}
                                </span>
                              </div>
                            </td>

                            <td>
                              {application.total_days}
                            </td>

                            <td>
                              <span
                                className={statusClass(
                                  application.status
                                )}
                              >
                                {statusLabel(
                                  application.status
                                )}
                              </span>
                            </td>

                            <td>
                              {application.reason || "-"}
                            </td>

                            <td>
                              <div className="leaveActions">
                                {application.status === "pending" && (
                                  <>
                                    <button
                                      type="button"
                                      className="actionButton approve"
                                      onClick={() =>
                                        handleApprove(application)
                                      }
                                      disabled={
                                        actionLoadingId !== null
                                      }
                                    >
                                      {actionLoadingId === application.id ? (
                                        <RefreshCw
                                          size={14}
                                          className="spin"
                                        />
                                      ) : (
                                        <CheckCircle2 size={14} />
                                      )}
                                      Approve
                                    </button>

                                    <button
                                      type="button"
                                      className="actionButton reject"
                                      onClick={() =>
                                        openRejectModal(application)
                                      }
                                      disabled={
                                        actionLoadingId !== null
                                      }
                                    >
                                      <XCircle size={14} />
                                      Reject
                                    </button>
                                  </>
                                )}

                                {application.status === "approved" && (
                                  <button
                                    type="button"
                                    className="actionButton cancel"
                                    onClick={() =>
                                      handleCancel(application)
                                    }
                                    disabled={
                                      actionLoadingId !== null
                                    }
                                  >
                                    {actionLoadingId === application.id ? (
                                      <RefreshCw
                                        size={14}
                                        className="spin"
                                      />
                                    ) : (
                                      <XCircle size={14} />
                                    )}
                                    Cancel
                                  </button>
                                )}

                                {application.status === "rejected" && (
                                  <span className="actionMuted">
                                    Rejected
                                  </span>
                                )}

                                {application.status === "cancelled" && (
                                  <span className="actionMuted">
                                    Cancelled
                                  </span>
                                )}
                              </div>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
              </>
            )}

            {activeTab === "balances" && (
              <>
                <div className="cardHeader">
                  <div>
                    <h2>Leave Balances</h2>
                    <p>
                      Track allocated, used, pending and
                      available leave.
                    </p>
                  </div>
                </div>

                {balances.length === 0 ? (
                  <div className="emptyState">
                    <Clock3 size={34} />
                    <h3>No balance records</h3>
                    <p>
                      No employee leave balances have been
                      configured.
                    </p>
                  </div>
                ) : (
                  <div className="tableWrapper">
                    <table className="leaveTable">
                      <thead>
                        <tr>
                          <th>Employee</th>
                          <th>Leave Type</th>
                          <th>Year</th>
                          <th>Allocated</th>
                          <th>Used</th>
                          <th>Pending</th>
                          <th>Available</th>
                        </tr>
                      </thead>

                      <tbody>
                        {balances.map((balance) => (
                          <tr key={balance.id}>
                            <td>
                              <strong>
                                {balance.employee_profile
                                  ?.employee_code ||
                                  `Employee #${balance.employee_profile_id}`}
                              </strong>
                            </td>

                            <td>
                              {balance.leave_type?.name || "-"}
                            </td>

                            <td>{balance.year}</td>

                            <td>{balance.allocated}</td>

                            <td>{balance.used}</td>

                            <td>{balance.pending}</td>

                            <td>
                              <strong>
                                {balance.available_balance ??
                                  Number(balance.allocated) +
                                    Number(
                                      balance.opening_balance
                                    ) +
                                    Number(
                                      balance.adjusted
                                    ) -
                                    Number(balance.used) -
                                    Number(balance.pending)}
                              </strong>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
              </>
            )}

            {activeTab === "types" && (
              <>
                <div className="cardHeader">
                  <div>
                    <h2>Leave Types</h2>
                    <p>
                      Leave categories configured in the HRM
                      system.
                    </p>
                  </div>
                </div>

                {leaveTypes.length === 0 ? (
                  <div className="emptyState">
                    <CalendarDays size={34} />
                    <h3>No leave types</h3>
                    <p>
                      No leave types are currently configured.
                    </p>
                  </div>
                ) : (
                  <div className="tableWrapper">
                    <table className="leaveTable">
                      <thead>
                        <tr>
                          <th>Name</th>
                          <th>Code</th>
                          <th>Annual Quota</th>
                          <th>Paid</th>
                          <th>Approval</th>
                          <th>Status</th>
                        </tr>
                      </thead>

                      <tbody>
                        {leaveTypes.map((type) => (
                          <tr key={type.id}>
                            <td>
                              <strong>{type.name}</strong>
                            </td>

                            <td>{type.code}</td>

                            <td>
                              {type.annual_quota}
                            </td>

                            <td>
                              {type.is_paid ? "Paid" : "Unpaid"}
                            </td>

                            <td>
                              {type.requires_approval
                                ? "Required"
                                : "Automatic"}
                            </td>

                            <td>
                              <span
                                className={
                                  type.is_active
                                    ? "statusBadge status-approved"
                                    : "statusBadge status-rejected"
                                }
                              >
                                {type.is_active
                                  ? "Active"
                                  : "Inactive"}
                              </span>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
              </>
            )}
          </>
        )}
      </div>
    </div>
  );
}