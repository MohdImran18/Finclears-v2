"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import {
  CalendarDays,
  Clock3,
  CheckCircle2,
  XCircle,
  Ban,
  RefreshCw,
  AlertCircle,
  Plus,
  X,
} from "lucide-react";

import {
  getLeaveApplications,
  getLeaveBalances,
  getLeaveTypes,
  createLeaveApplication,
  approveLeaveApplication,
  rejectLeaveApplication,
  cancelLeaveApplication,
} from "@/lib/api/leave/leaveApi";

import type {
  EmployeeLeaveBalance,
  LeaveApplication,
  LeaveType,
} from "@/types/leave/leave";

type Tab = "applications" | "balances" | "types";

function formatDate(value: string) {
  if (!value) return "-";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return value;
  }

  return date.toLocaleDateString("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
}

function statusLabel(status: LeaveApplication["status"]) {
  return status.charAt(0).toUpperCase() + status.slice(1);
}

function statusClass(status: LeaveApplication["status"]) {
  return `statusBadge status-${status}`;
}

export default function LeavePage() {
  const [activeTab, setActiveTab] =
    useState<Tab>("applications");

  const [applications, setApplications] = useState<
    LeaveApplication[]
  >([]);

  const [balances, setBalances] = useState<
    EmployeeLeaveBalance[]
  >([]);

  const [leaveTypes, setLeaveTypes] = useState<LeaveType[]>([]);

  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  const [showCreateForm, setShowCreateForm] = useState(false);
  const [saving, setSaving] = useState(false);
  const [formError, setFormError] = useState("");

  const [actionLoadingId, setActionLoadingId] = useState<number | null>(null);
  const [actionError, setActionError] = useState("");
  const [actionSuccess, setActionSuccess] = useState("");
  const [rejectingApplication, setRejectingApplication] =
    useState<LeaveApplication | null>(null);
  const [rejectionReason, setRejectionReason] = useState("");

  const [form, setForm] = useState({
    employee_profile_id: "",
    leave_type_id: "",
    from_date: "",
    to_date: "",
    reason: "",
  });

  const selectedBalance = useMemo(() => {
    if (!form.employee_profile_id || !form.leave_type_id) {
      return null;
    }

    return (
      balances.find(
        (item) =>
          String(item.employee_profile_id) ===
            form.employee_profile_id &&
          String(item.leave_type_id) ===
            form.leave_type_id
      ) || null
    );
  }, [
    balances,
    form.employee_profile_id,
    form.leave_type_id,
  ]);

  const calculatedDays = useMemo(() => {
    if (!form.from_date || !form.to_date) {
      return 0;
    }

    const from = new Date(`${form.from_date}T00:00:00`);
    const to = new Date(`${form.to_date}T00:00:00`);

    if (
      Number.isNaN(from.getTime()) ||
      Number.isNaN(to.getTime()) ||
      to < from
    ) {
      return 0;
    }

    return Math.floor(
      (to.getTime() - from.getTime()) /
        (1000 * 60 * 60 * 24)
    ) + 1;
  }, [form.from_date, form.to_date]);

  const openCreateForm = () => {
    setFormError("");
    setForm({
      employee_profile_id: "",
      leave_type_id: "",
      from_date: "",
      to_date: "",
      reason: "",
    });
    setShowCreateForm(true);
  };

  const closeCreateForm = () => {
    if (saving) return;

    setShowCreateForm(false);
    setFormError("");
  };

  const handleCreateApplication = async (
    event: React.FormEvent<HTMLFormElement>
  ) => {
    event.preventDefault();
    setFormError("");

    if (
      !form.employee_profile_id ||
      !form.leave_type_id ||
      !form.from_date ||
      !form.to_date
    ) {
      setFormError(
        "Please fill all required fields."
      );
      return;
    }

    if (calculatedDays <= 0) {
      setFormError(
        "Please select a valid leave date range."
      );
      return;
    }

    if (
      selectedBalance &&
      calculatedDays >
        Number(
          selectedBalance.available_balance ??
            Number(selectedBalance.opening_balance) +
              Number(selectedBalance.allocated) +
              Number(selectedBalance.adjusted) -
              Number(selectedBalance.used) -
              Number(selectedBalance.pending)
        )
    ) {
      setFormError(
        `Insufficient leave balance. Available balance: ${
          selectedBalance.available_balance ??
          0
        } days.`
      );
      return;
    }

    try {
      setSaving(true);

      await createLeaveApplication({
        employee_profile_id: Number(
          form.employee_profile_id
        ),
        leave_type_id: Number(form.leave_type_id),
        from_date: form.from_date,
        to_date: form.to_date,
        reason: form.reason.trim() || undefined,
      });

      setShowCreateForm(false);
      setFormError("");
      await loadData();
    } catch (err) {
      setFormError(
        err instanceof Error
          ? err.message
          : "Unable to submit leave application."
      );
    } finally {
      setSaving(false);
    }
  };

  const handleApprove = async (application: LeaveApplication) => {
    if (actionLoadingId !== null) return;

    setActionError("");
    setActionSuccess("");

    try {
      setActionLoadingId(application.id);

      const response = await approveLeaveApplication(application.id);

      setActionSuccess(
        response.message || "Leave application approved successfully."
      );

      await loadData();
    } catch (err) {
      setActionError(
        err instanceof Error
          ? err.message
          : "Unable to approve leave application."
      );
    } finally {
      setActionLoadingId(null);
    }
  };

  const openRejectModal = (application: LeaveApplication) => {
    setActionError("");
    setActionSuccess("");
    setRejectionReason("");
    setRejectingApplication(application);
  };

  const closeRejectModal = () => {
    if (actionLoadingId !== null) return;

    setRejectingApplication(null);
    setRejectionReason("");
  };

  const handleReject = async (
    event: React.FormEvent<HTMLFormElement>
  ) => {
    event.preventDefault();

    if (!rejectingApplication || actionLoadingId !== null) {
      return;
    }

    const reason = rejectionReason.trim();

    if (!reason) {
      setActionError("Please enter a rejection reason.");
      return;
    }

    setActionError("");
    setActionSuccess("");

    try {
      setActionLoadingId(rejectingApplication.id);

      const response = await rejectLeaveApplication(
        rejectingApplication.id,
        reason
      );

      setRejectingApplication(null);
      setRejectionReason("");

      setActionSuccess(
        response.message || "Leave application rejected successfully."
      );

      await loadData();
    } catch (err) {
      setActionError(
        err instanceof Error
          ? err.message
          : "Unable to reject leave application."
      );
    } finally {
      setActionLoadingId(null);
    }
  };

  const handleCancel = async (application: LeaveApplication) => {
    if (actionLoadingId !== null) return;

    const confirmed = window.confirm(
      `Cancel leave application for ${application.employee_profile?.employee_code || `Employee #${application.employee_profile_id}`}?`
    );

    if (!confirmed) return;

    setActionError("");
    setActionSuccess("");

    try {
      setActionLoadingId(application.id);

      const response = await cancelLeaveApplication(application.id);

      setActionSuccess(
        response.message || "Leave application cancelled successfully."
      );

      await loadData();
    } catch (err) {
      setActionError(
        err instanceof Error
          ? err.message
          : "Unable to cancel leave application."
      );
    } finally {
      setActionLoadingId(null);
    }
  };

  const loadData = useCallback(async () => {
    setLoading(true);
    setError("");

    try {
      const [
        applicationsResponse,
        balancesResponse,
        leaveTypesResponse,
      ] = await Promise.all([
        getLeaveApplications({
          per_page: 100,
        }),
        getLeaveBalances({
          per_page: 100,
        }),
        getLeaveTypes(),
      ]);

      setApplications(applicationsResponse.data.data || []);
      setBalances(balancesResponse.data.data || []);
      setLeaveTypes(leaveTypesResponse.data || []);
    } catch (err) {
      const message =
        err instanceof Error
          ? err.message
          : "Unable to load leave data.";

      setError(message);
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    loadData();
  }, [loadData]);

  const counts = useMemo(() => {
    return {
      total: applications.length,
      pending: applications.filter(
        (item) => item.status === "pending"
      ).length,
      approved: applications.filter(
        (item) => item.status === "approved"
      ).length,
      rejected: applications.filter(
        (item) => item.status === "rejected"
      ).length,
      cancelled: applications.filter(
        (item) => item.status === "cancelled"
      ).length,
    };
  }, [applications]);

  return (
    <div className="pageContainer">
      <div className="pageHeader">
        <div>
          <h1>Leave Management</h1>
          <p>
            Manage employee leave applications, balances and
            leave types.
          </p>
        </div>

        <button
          type="button"
          className="secondaryButton"
          onClick={loadData}
          disabled={loading}
        >
          <RefreshCw
            size={16}
            className={loading ? "spin" : ""}
          />
          Refresh
        </button>
      </div>

      {actionSuccess && (
        <div className="successBanner">
          <CheckCircle2 size={18} />
          <span>{actionSuccess}</span>
        </div>
      )}

      {actionError && (
        <div className="errorBanner">
          <AlertCircle size={18} />
          <div>
            <strong>Leave action failed</strong>
            <span>{actionError}</span>
          </div>
        </div>
      )}

      {error && (
        <div className="errorBanner">
          <AlertCircle size={18} />
          <div>
            <strong>Unable to load leave data</strong>
            <span>{error}</span>
          </div>
        </div>
      )}

      <div className="statsGrid">
        <div className="statCard">
          <div className="statIcon">
            <CalendarDays size={19} />
          </div>

          <div>
            <span>Total Applications</span>
            <strong>
              {loading ? "ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¾Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â¦ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â" : counts.total}
            </strong>
          </div>
        </div>

        <div className="statCard">
          <div className="statIcon">
            <Clock3 size={19} />
          </div>

          <div>
            <span>Pending</span>
            <strong>
